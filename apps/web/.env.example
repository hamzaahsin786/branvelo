# Mezban web — copy to .env.local (never commit the real one)

# Fastify API base URL (Render URL in production)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Supabase — used ONLY for Auth (admin login) + Realtime subscriptions.
# All business data flows through the API above.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Dev fallback when no subdomain or /t/<slug> matches
DEFAULT_TENANT_SLUG=usama-burgers
