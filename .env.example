# Copy to .env for local overrides. Defaults in docker-compose.yml already
# work without this file; .env is only for changing values.
POSTGRES_DB=branvelo
POSTGRES_USER=branvelo
POSTGRES_PASSWORD=branvelo-dev-password

# Legacy v1 values only - the v2 app does not use Supabase at all.
# Leave these blank.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
DEFAULT_TENANT_SLUG=usama-burgers

# Platform super-admin (Phase 2): set both and the api container creates
# this Django admin account on boot (bootstrap_platform). Leave empty to
# create one manually with: docker compose exec api python manage.py createsuperuser
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# Menu photo import (optional): a free Gemini API key from Google AI
# Studio. Set it and restart the api container to switch the photo
# import on in Menu Manager -> Import menu. Spreadsheet import does not
# need this.
GEMINI_API_KEY=
